+namespace odin {
+
+namespace {
+
+/* What a finger may hold */
+enum Part : int {
+	NOTHING = -1,
+	STICK = 0,
+	BUTTON_A, BUTTON_B, BUTTON_X, BUTTON_Y,
+	SHOULDER_L, SHOULDER_R, TRIGGER_L, TRIGGER_R,
+	START, COIN, MENU, TOOLS,
+	PARTS,
+	/* A finger on a key of the panel of shortcuts */
+	PANEL_KEY = PARTS
+};
+
+constexpr const char *LABELS[PARTS] = { "", "A", "B", "X", "Y", "LB", "RB", "LT", "RT", "START", "COIN", "MENU", "" };
+
+/* The SDL button each part presses (none for the stick and the triggers) */
+constexpr int BUTTONS[PARTS] = {
+	-1,
+	SDL_GAMEPAD_BUTTON_SOUTH, SDL_GAMEPAD_BUTTON_EAST, SDL_GAMEPAD_BUTTON_WEST, SDL_GAMEPAD_BUTTON_NORTH,
+	SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, -1, -1,
+	SDL_GAMEPAD_BUTTON_START, SDL_GAMEPAD_BUTTON_BACK, SDL_GAMEPAD_BUTTON_GUIDE, -1,
+};
+
+/* The panel of shortcuts (TOOLS): the keys of the hotkeys of Odin by
+ * default (hotkeys.cpp), which a phone has not. TEST and SERVICE, the
+ * switches of the cabinet, are held as long as the finger is, and leave the
+ * panel open to walk the test menus of the games; the others close it.
+ * GAMES (back to the library) and QUIT ask for a second touch. */
+struct Shortcut {
+	const char *label;
+	const char *hint;
+	SDL_Keycode key;
+	SDL_Keymod mod;
+	bool stays;
+	bool confirm;
+};
+
+constexpr Shortcut SHORTCUTS[] = {
+	{ "SAVE", "state", SDLK_F2, SDL_KMOD_NONE, false, false },
+	{ "LOAD", "state", SDLK_F4, SDL_KMOD_NONE, false, false },
+	{ "PAUSE", "on / off", SDLK_P, SDL_KMOD_NONE, false, false },
+	{ "RESET", "cabinet", SDLK_R, SDL_KMOD_LCTRL, false, false },
+	{ "QUIT", "Odin", SDLK_Q, SDL_KMOD_LCTRL, false, true },
+	{ "TEST", "cabinet", SDLK_0, SDL_KMOD_NONE, true, false },
+	{ "SERVICE", "cabinet", SDLK_9, SDL_KMOD_NONE, true, false },
+	{ "CARD", "in / out", SDLK_F6, SDL_KMOD_NONE, false, false },
+	{ "GAMES", "the list", SDLK_C, SDL_KMOD_LCTRL, false, true },
+	{ "CLOSE", "this panel", SDLK_UNKNOWN, SDL_KMOD_NONE, false, false },
+};
+constexpr int SHORTCUT_COLUMNS = 5;
+/* How long a shortcut that asks for a second touch waits for it */
+constexpr Uint64 CONFIRM_NS = 4'000'000'000;
+constexpr int SHORTCUT_COUNT = static_cast<int>(sizeof(SHORTCUTS) / sizeof(SHORTCUTS[0]));
+
+/* The buttons of the virtual gamepad, in the order SDL numbers them */
+constexpr SDL_GamepadButton MASK_BUTTONS[] = {
+	SDL_GAMEPAD_BUTTON_SOUTH, SDL_GAMEPAD_BUTTON_EAST, SDL_GAMEPAD_BUTTON_WEST, SDL_GAMEPAD_BUTTON_NORTH,
+	SDL_GAMEPAD_BUTTON_BACK, SDL_GAMEPAD_BUTTON_GUIDE, SDL_GAMEPAD_BUTTON_START,
+	SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER,
+};
+
+/* A round or a rounded box, in the points of the window */
+struct Shape {
+	float x = 0, y = 0;	/* centre */
+	float w = 0, h = 0;	/* a round when h is 0: w its radius */
+
+	bool round() const { return h <= 0.0f; }
+	bool hit(float px, float py, float slack) const
+	{
+		if (round())
+			return std::hypot(px - x, py - y) <= w * slack;
+		return std::fabs(px - x) <= w * 0.5f * slack && std::fabs(py - y) <= h * 0.5f * slack;
+	}
+};
+
+struct Finger {
+	SDL_FingerID id = 0;
+	int part = NOTHING;	/* a Part, or PANEL_KEY */
+	float x = 0, y = 0;	/* points */
+	int shortcut = -1;	/* on PANEL_KEY: its SHORTCUTS */
+	float ox = 0, oy = 0;	/* on the stick: its centre, where the finger came down */
+};
+
+/* A key to send to Odin, from its own thread (touch_pad_draw) */
+struct KeySent {
+	SDL_Keycode key;
+	SDL_Keymod mod;
+	bool down;
+};
+
+/* Shared between the thread that sends the touches (Android's) and the one
+ * that runs Odin */
+struct State {
+	std::mutex mutex;
+	std::array<Finger, 10> fingers{};
+	std::array<Shape, PARTS> shapes{};
+	/* The panel of shortcuts: open or not, its box and its keys */
+	bool panel = false;
+	/* A shortcut touched once that asks for a second touch (-1: none),
+	 * since when, and the one whose key went down on the second */
+	int armed = -1;
+	Uint64 armed_ns = 0;
+	int confirmed = -1;
+	Shape panel_box;
+	std::array<Shape, SHORTCUT_COUNT> panel_keys{};
+	std::vector<KeySent> keys_to_send;
+	float room_w = 0, room_h = 0;	/* the window, in points, when drawn */
+	SDL_JoystickID id = 0;
+	int users = 0;	/* the Controls that plugged it */
+	bool watching = false;
+	/* The touch that came as the mouse began on the pad: its mouse events
+	 * are the pad's */
+	bool mouse_taken = false;
+};
+
+State g_state;
+/* The touches that landed on a part, for a short buzz (Odin's thread) */
+std::atomic<unsigned> g_buzzes{ 0 };
+std::atomic<bool> g_twin{ false };
+SDL_Haptic *g_haptic = nullptr;
+bool g_haptic_looked = false;
+std::atomic<Uint64> g_drawn_ns{ 0 };
+std::atomic<bool> g_hidden{ false };
+std::atomic<float> g_fps{ 0.0f };
+
+constexpr Uint64 SHOWN_NS = 250'000'000;
+
+bool
+shown()
+{
+	const Uint64 drawn = g_drawn_ns.load();
+
+	return drawn && SDL_GetTicksNS() - drawn < SHOWN_NS && !g_hidden.load();
+}
+
+/* The parts laid out for a window of w by h points, landscape or not */
+void
+lay_out(std::array<Shape, PARTS> &s, float w, float h)
+{
+	const float u = std::min(w, h);
+	const float stick = 0.16f * u, button = 0.075f * u, gap = 0.135f * u;
+	const float face_x = w - 0.24f * u, face_y = h - 0.30f * u;
+
+	s[STICK] = { 0.25f * u, h - 0.28f * u, stick, 0 };
+	s[BUTTON_A] = { face_x, face_y + gap, button, 0 };
+	s[BUTTON_B] = { face_x + gap, face_y, button, 0 };
+	s[BUTTON_X] = { face_x - gap, face_y, button, 0 };
+	s[BUTTON_Y] = { face_x, face_y - gap, button, 0 };
+
+	const float bw = 0.22f * u, bh = 0.10f * u, top = 0.10f * u;
+
+	s[TRIGGER_L] = { 0.04f * u + bw * 0.5f, top + bh * 0.5f, bw, bh };
+	s[SHOULDER_L] = { 0.04f * u + bw * 0.5f, top + bh * 1.75f, bw, bh };
+	s[TRIGGER_R] = { w - 0.04f * u - bw * 0.5f, top + bh * 0.5f, bw, bh };
+	s[SHOULDER_R] = { w - 0.04f * u - bw * 0.5f, top + bh * 1.75f, bw, bh };
+
+	const float sw = 0.17f * u, sh = 0.075f * u;
+
+	if (w > h) {
+		/* Held flat: every part in the two columns at the sides, none over
+		 * the middle of the picture, whatever its shape: MENU and the
+		 * shortcuts between the shoulders and the stick or the face
+		 * buttons, COIN and START in the bottom corners */
+		const float mid = top + bh * 2.25f + 0.08f * u;
+
+		s[MENU] = { 0.04f * u + bw * 0.5f, mid, sw, sh };
+		s[TOOLS] = { w - 0.04f * u - bw * 0.5f, mid, sw, sh };
+		s[COIN] = { 0.02f * u + sw * 0.5f, h - 0.045f * u, sw, sh };
+		s[START] = { w - 0.02f * u - sw * 0.5f, h - 0.045f * u, sw, sh };
+		return;
+	}
+	s[COIN] = { w * 0.5f - sw * 0.65f, h - 0.07f * u, sw, sh };
+	s[START] = { w * 0.5f + sw * 0.65f, h - 0.07f * u, sw, sh };
+	/* MENU and the shortcuts at the top, as COIN and START at the bottom */
+	s[MENU] = { w * 0.5f - sw * 0.65f, 0.06f * u, sw, sh };
+	s[TOOLS] = { w * 0.5f + sw * 0.65f, 0.06f * u, sw, sh };
+}
+
+/* The panel of shortcuts in the middle of the window, its keys in rows of
+ * SHORTCUT_COLUMNS */
+void
+lay_out_panel(Shape &box, std::array<Shape, SHORTCUT_COUNT> &keys, float w, float h)
+{
+	const float u = std::min(w, h);
+	const int rows = (SHORTCUT_COUNT + SHORTCUT_COLUMNS - 1) / SHORTCUT_COLUMNS;
+	const float key_w = std::min(0.30f * u, (w * 0.86f) / SHORTCUT_COLUMNS), key_h = 0.17f * u;
+	const float gap = 0.035f * u, title = 0.11f * u, pad = 0.05f * u;
+	const float bw = SHORTCUT_COLUMNS * key_w + (SHORTCUT_COLUMNS - 1) * gap + 2.0f * pad;
+	const float bh = title + rows * key_h + (rows - 1) * gap + 2.0f * pad;
+
+	box = { w * 0.5f, h * 0.5f, bw, bh };
+	for (int k = 0; k < SHORTCUT_COUNT; k++) {
+		const int row = k / SHORTCUT_COLUMNS, column = k % SHORTCUT_COLUMNS;
+
+		keys[static_cast<size_t>(k)] = { box.x - bw * 0.5f + pad + key_w * 0.5f + static_cast<float>(column) * (key_w + gap),
+			                         box.y - bh * 0.5f + pad + title + key_h * 0.5f + static_cast<float>(row) * (key_h + gap),
+			                         key_w, key_h };
+	}
+}
+
+int
+shortcut_at(float x, float y)
+{
+	for (int k = 0; k < SHORTCUT_COUNT; k++)
+		if (g_state.panel_keys[static_cast<size_t>(k)].hit(x, y, 1.0f))
+			return k;
+	return -1;
+}
+
+/* A shortcut pressed or let go: its key sent, the panel closed after one
+ * that does not stay */
+void
+press_shortcut(int k, bool down)
+{
+	const Shortcut &shortcut = SHORTCUTS[k];
+
+	if (shortcut.confirm) {
+		if (down) {
+			if (g_state.armed == k && SDL_GetTicksNS() - g_state.armed_ns < CONFIRM_NS) {
+				g_state.keys_to_send.push_back({ shortcut.key, shortcut.mod, true });
+				g_state.confirmed = k;
+			} else {
+				g_state.armed = k;
+				g_state.armed_ns = SDL_GetTicksNS();
+			}
+		} else if (g_state.confirmed == k) {
+			g_state.keys_to_send.push_back({ shortcut.key, shortcut.mod, false });
+			g_state.confirmed = g_state.armed = -1;
+			g_state.panel = false;
+		}
+		return;
+	}
+	g_state.armed = -1;
+	if (shortcut.key != SDLK_UNKNOWN)
+		g_state.keys_to_send.push_back({ shortcut.key, shortcut.mod, down });
+	if (!down && !shortcut.stays)
+		g_state.panel = false;
+}
+
+/* The part under a point; the stick reaches further than it is drawn */
+Part
+part_at(const std::array<Shape, PARTS> &s, float x, float y)
+{
+	for (int p = BUTTON_A; p < PARTS; p++)
+		if (s[static_cast<size_t>(p)].hit(x, y, 1.15f))
+			return static_cast<Part>(p);
+	/* The stick floats: it takes a thumb that comes down near it */
+	if (s[STICK].hit(x, y, 2.3f))
+		return STICK;
+	return NOTHING;
+}
+
+Finger *
+finger_of(SDL_FingerID id)
+{
+	for (Finger &f : g_state.fingers)
+		if (f.part != NOTHING && f.id == id)
+			return &f;
+	return nullptr;
+}
+
+/* The touches, as they come (the thread that sends them); the mouse that
+ * a touch on the pad makes swallowed, the back key of Android made the
+ * Escape of Odin's menu */
+bool SDLCALL
+filter(void *, SDL_Event *event)
+{
+	switch (event->type) {
+	case SDL_EVENT_KEY_DOWN:
+	case SDL_EVENT_KEY_UP:
+		if (event->key.key == SDLK_AC_BACK) {
+			event->key.key = SDLK_ESCAPE;
+			event->key.scancode = SDL_SCANCODE_ESCAPE;
+		}
+		return true;
+	case SDL_EVENT_FINGER_DOWN:
+	case SDL_EVENT_FINGER_MOTION:
+	case SDL_EVENT_FINGER_UP:
+	case SDL_EVENT_FINGER_CANCELED: {
+		if (event->tfinger.touchID == SDL_MOUSE_TOUCHID)
+			return true;
+
+		const std::lock_guard<std::mutex> lock(g_state.mutex);
+		const float x = event->tfinger.x * g_state.room_w, y = event->tfinger.y * g_state.room_h;
+		Finger *f = finger_of(event->tfinger.fingerID);
+
+		if (event->type == SDL_EVENT_FINGER_DOWN) {
+			if (!shown() || f)
+				return true;
+
+			Part part = part_at(g_state.shapes, x, y);
+			int shortcut = -1;
+
+			/* The panel open: its keys, TOOLS that closes it; a touch
+			 * anywhere else closes it too */
+			if (g_state.panel && part != TOOLS) {
+				shortcut = shortcut_at(x, y);
+				if (shortcut < 0) {
+					if (!g_state.panel_box.hit(x, y, 1.0f))
+						g_state.panel = false;
+					return true;
+				}
+			}
+			if (part == TOOLS) {
+				g_state.panel = !g_state.panel;
+				g_buzzes++;
+				return true;
+			}
+			if (part == NOTHING && shortcut < 0)
+				return true;
+			for (Finger &free : g_state.fingers)
+				if (free.part == NOTHING) {
+					free = { event->tfinger.fingerID, shortcut >= 0 ? PANEL_KEY : part, x, y, shortcut };
+					if (part == STICK && shortcut < 0) {
+						/* Its centre under the thumb, the whole ring on
+						 * the screen */
+						const float r = g_state.shapes[STICK].w;
+
+						free.ox = std::clamp(x, r, std::max(r, g_state.room_w * 0.5f));
+						free.oy = std::clamp(y, r, std::max(r, g_state.room_h - r));
+					}
+					if (shortcut >= 0)
+						press_shortcut(shortcut, true);
+					g_buzzes++;
+					break;
+				}
+		} else if (f && f->part == PANEL_KEY) {
+			if (event->type != SDL_EVENT_FINGER_MOTION) {
+				press_shortcut(f->shortcut, false);
+				f->part = NOTHING;
+			}
+		} else if (f && event->type == SDL_EVENT_FINGER_MOTION) {
+			f->x = x;
+			f->y = y;
+			/* A finger slides from button to button, not off the stick */
+			if (f->part != STICK) {
+				const Part part = part_at(g_state.shapes, x, y);
+
+				if (part != NOTHING && part != STICK)
+					f->part = part;
+			}
+		} else if (f) {
+			f->part = NOTHING;
+		}
+		return true;
+	}
+	case SDL_EVENT_MOUSE_BUTTON_DOWN:
+	case SDL_EVENT_MOUSE_BUTTON_UP:
+	case SDL_EVENT_MOUSE_MOTION: {
+		if (event->type == SDL_EVENT_MOUSE_MOTION ? event->motion.which != SDL_TOUCH_MOUSEID :
+		                                            event->button.which != SDL_TOUCH_MOUSEID)
+			return true;
+
+		const std::lock_guard<std::mutex> lock(g_state.mutex);
+
+		/* The panel open, every touch is its */
+		if (event->type == SDL_EVENT_MOUSE_BUTTON_DOWN)
+			g_state.mouse_taken = shown() && (g_state.panel || part_at(g_state.shapes, event->button.x, event->button.y) != NOTHING);
+		const bool taken = g_state.mouse_taken;
+		if (event->type == SDL_EVENT_MOUSE_BUTTON_UP)
+			g_state.mouse_taken = false;
+		return !taken;
+	}
+	default:
+		return true;
+	}
+}
+
+/* The fingers given to the pad (Odin's thread, as SDL updates the
+ * joysticks) */
+void SDLCALL
+update(void *)
+{
+	std::array<bool, SDL_GAMEPAD_BUTTON_COUNT> buttons{};
+	float stick_x = 0, stick_y = 0;
+	bool trigger_l = false, trigger_r = false;
+	SDL_JoystickID id;
+	{
+		const std::lock_guard<std::mutex> lock(g_state.mutex);
+		const bool on = shown();
+
+		id = g_state.id;
+		for (Finger &f : g_state.fingers) {
+			if (f.part == NOTHING)
+				continue;
+			if (!on) {
+				/* A shortcut held as the pad goes: let go */
+				if (f.part == PANEL_KEY)
+					press_shortcut(f.shortcut, false);
+				f.part = NOTHING;
+				continue;
+			}
+			if (f.part == PANEL_KEY)
+				continue;
+			if (f.part == STICK) {
+				const Shape &s = g_state.shapes[STICK];
+				float dx = (f.x - f.ox) / s.w, dy = (f.y - f.oy) / s.w;
+				const float length = std::hypot(dx, dy);
+
+				if (length > 1.0f) {
+					dx /= length;
+					dy /= length;
+				}
+				stick_x = dx;
+				stick_y = dy;
+			} else if (f.part == TRIGGER_L) {
+				trigger_l = true;
+			} else if (f.part == TRIGGER_R) {
+				trigger_r = true;
+			} else if (f.part < PARTS && BUTTONS[f.part] >= 0) {
+				buttons[static_cast<size_t>(BUTTONS[f.part])] = true;
+			}
+		}
+	}
+	SDL_Joystick *const joystick = SDL_GetJoystickFromID(id);
+
+	if (!joystick)
+		return;
+	/* Hidden while another gamepad is plugged in, looked at twice a second */
+	static Uint64 looked = 0;
+	if (const Uint64 now = SDL_GetTicksNS(); now - looked > 500'000'000) {
+		int count = 0;
+		bool other = false;
+
+		looked = now;
+		if (SDL_JoystickID *const pads = SDL_GetGamepads(&count)) {
+			for (int i = 0; i < count; i++)
+				other = other || (pads[i] != id && !SDL_IsJoystickVirtual(pads[i]));
+			SDL_free(pads);
+		}
+		g_hidden = other;
+	}
+	const auto axis = [](float v) { return static_cast<Sint16>(std::clamp(v, -1.0f, 1.0f) * 32767.0f); };
+
+	/* SDL numbers the inputs of a virtual gamepad as its masks have them,
+	 * those it has not left out (SDL_virtualjoystick.c): the axes and the
+	 * buttons below in that order, not by the numbers of their names */
+	/* Two levers: forward both, a turn to the right the left engine ahead
+	 * of the right one */
+	const bool twin = g_twin.load();
+	const float left_y = twin ? std::clamp(stick_y - stick_x, -1.0f, 1.0f) : stick_y;
+	const float right_y = twin ? std::clamp(stick_y + stick_x, -1.0f, 1.0f) : 0.0f;
+
+	SDL_SetJoystickVirtualAxis(joystick, 0, axis(twin ? 0.0f : stick_x));
+	SDL_SetJoystickVirtualAxis(joystick, 1, axis(left_y));
+	SDL_SetJoystickVirtualAxis(joystick, 2, 0);
+	SDL_SetJoystickVirtualAxis(joystick, 3, axis(right_y));
+	SDL_SetJoystickVirtualAxis(joystick, 4, trigger_l ? 32767 : -32768);
+	SDL_SetJoystickVirtualAxis(joystick, 5, trigger_r ? 32767 : -32768);
+	for (size_t b = 0; b < std::size(MASK_BUTTONS); b++)
+		SDL_SetJoystickVirtualButton(joystick, static_cast<int>(b),
+		                             buttons[static_cast<size_t>(MASK_BUTTONS[b])]);
+}
+
+} /* namespace */
+
+bool
+touch_pad_wanted()
+{
+#if defined(__ANDROID__)
+	return !SDL_GetHintBoolean("ODIN_NO_TOUCH_PAD", false) && !SDL_getenv("ODIN_NO_TOUCH_PAD");
+#else
+	return SDL_getenv("ODIN_TOUCH_PAD") != nullptr;
+#endif
+}
+
+void
+touch_pad_attach()
+{
+	if (!touch_pad_wanted())
+		return;
+
+	const std::lock_guard<std::mutex> lock(g_state.mutex);
+
+	if (!g_state.watching) {
+		SDL_SetEventFilter(filter, nullptr);
+		g_state.watching = true;
+	}
+	if (g_state.users++ > 0 && g_state.id)
+		return;
+
+	SDL_VirtualJoystickDesc desc;
+
+	SDL_INIT_INTERFACE(&desc);
+	desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+	desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+	desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+	desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_LEFTX) | (1u << SDL_GAMEPAD_AXIS_LEFTY) |
+	                 (1u << SDL_GAMEPAD_AXIS_RIGHTX) | (1u << SDL_GAMEPAD_AXIS_RIGHTY) |
+	                 (1u << SDL_GAMEPAD_AXIS_LEFT_TRIGGER) | (1u << SDL_GAMEPAD_AXIS_RIGHT_TRIGGER);
+	desc.button_mask = 0;
+	for (const SDL_GamepadButton button : MASK_BUTTONS)
+		desc.button_mask |= 1u << button;
+	desc.name = "Odin touch pad";
+	desc.Update = update;
+	g_state.id = SDL_AttachVirtualJoystick(&desc);
+	if (!g_state.id)
+		std::fprintf(stderr, "ERROR: touch pad: %s\n", SDL_GetError());
+	else
+		std::printf("touch pad: plugged\n");
+}
+
+void
+touch_pad_detach()
+{
+	if (!touch_pad_wanted())
+		return;
+
+	SDL_JoystickID id;
+	{
+		const std::lock_guard<std::mutex> lock(g_state.mutex);
+
+		if (g_state.users > 0 && --g_state.users > 0)
+			return;
+		id = g_state.id;
+		g_state.id = 0;
+		for (Finger &f : g_state.fingers)
+			f.part = NOTHING;
+	}
+	if (id)
+		SDL_DetachVirtualJoystick(id);
+}
+
+void
+touch_pad_twin_levers(bool on)
+{
+	g_twin = on;
+}
+
+void
+touch_pad_speed(float fps)
+{
+	g_fps = fps;
+}
+
+void
+touch_pad_draw()
+{
+	if (!touch_pad_wanted() || !ImGui::GetCurrentContext())
+		return;
+
+	const ImVec2 room = ImGui::GetIO().DisplaySize;
+	std::array<Shape, PARTS> shapes;
+	std::array<bool, PARTS> held{};
+	std::array<Shape, SHORTCUT_COUNT> panel_keys;
+	std::array<bool, SHORTCUT_COUNT> panel_held{};
+	std::vector<KeySent> keys;
+	Shape panel_box;
+	bool panel;
+	int armed;
+	ImVec2 knob, stick_at;
+	bool connected;
+	{
+		const std::lock_guard<std::mutex> lock(g_state.mutex);
+
+		g_state.room_w = room.x;
+		g_state.room_h = room.y;
+		lay_out(g_state.shapes, room.x, room.y);
+		lay_out_panel(g_state.panel_box, g_state.panel_keys, room.x, room.y);
+		shapes = g_state.shapes;
+		if (!g_state.panel || SDL_GetTicksNS() - g_state.armed_ns >= CONFIRM_NS)
+			g_state.armed = -1;
+		panel = g_state.panel;
+		armed = g_state.armed;
+		panel_box = g_state.panel_box;
+		panel_keys = g_state.panel_keys;
+		keys.swap(g_state.keys_to_send);
+		connected = g_state.id != 0;
+		knob = { shapes[STICK].x, shapes[STICK].y };
+		stick_at = knob;
+		for (const Finger &f : g_state.fingers) {
+			if (f.part == NOTHING)
+				continue;
+			if (f.part == PANEL_KEY) {
+				panel_held[static_cast<size_t>(f.shortcut)] = true;
+				continue;
+			}
+			held[static_cast<size_t>(f.part)] = true;
+			if (f.part == STICK) {
+				const Shape &s = shapes[STICK];
+				float dx = f.x - f.ox, dy = f.y - f.oy;
+
+				stick_at = { f.ox, f.oy };
+				const float length = std::hypot(dx, dy);
+
+				if (length > s.w) {
+					dx *= s.w / length;
+					dy *= s.w / length;
+				}
+				knob = { f.ox + dx, f.oy + dy };
+			}
+		}
+	}
+	/* The keys of the shortcuts, as a keyboard would send them */
+	for (const KeySent &k : keys) {
+		SDL_Event event{};
+		SDL_Window *const window = SDL_GetKeyboardFocus();
+
+		event.type = k.down ? SDL_EVENT_KEY_DOWN : SDL_EVENT_KEY_UP;
+		event.key.timestamp = SDL_GetTicksNS();
+		event.key.windowID = window ? SDL_GetWindowID(window) : 0;
+		event.key.key = k.key;
+		event.key.scancode = SDL_GetScancodeFromKey(k.key, nullptr);
+		event.key.mod = k.mod;
+		event.key.down = k.down;
+		SDL_PushEvent(&event);
+	}
+	/* A short buzz for each touch that landed on the pad: the phone's
+	 * vibrator, as SDL gives it (Android's VIBRATOR_SERVICE) */
+	if (const unsigned buzzes = g_buzzes.exchange(0); buzzes && !SDL_getenv("ODIN_NO_BUZZ")) {
+		if (!g_haptic_looked) {
+			g_haptic_looked = true;
+			int count = 0;
+
+			if (SDL_InitSubSystem(SDL_INIT_HAPTIC))
+				if (SDL_HapticID *const haptics = SDL_GetHaptics(&count)) {
+					/* The phone's own, not a gamepad's */
+					for (int i = 0; i < count && !g_haptic; i++)
+						if (const char *name = SDL_GetHapticNameForID(haptics[i]))
+							if (std::string_view(name) == "VIBRATOR_SERVICE")
+								g_haptic = SDL_OpenHaptic(haptics[i]);
+					SDL_free(haptics);
+				}
+			if (g_haptic && !SDL_InitHapticRumble(g_haptic)) {
+				SDL_CloseHaptic(g_haptic);
+				g_haptic = nullptr;
+			}
+			std::printf("touch pad: %s\n", g_haptic ? "buzzes" : "no vibrator to buzz");
+		}
+		if (g_haptic)
+			SDL_PlayHapticRumble(g_haptic, 0.4f, 12);
+	}
+	if (!connected)
+		return;
+	g_drawn_ns = SDL_GetTicksNS();
+	if (g_hidden.load())
+		return;
+
+	ImDrawList *const draw = ImGui::GetForegroundDrawList();
+	/* Over the picture (a wide one, 16:9 or the whole window: the bars at
+	 * its sides narrower than the columns of the pad), the parts are
+	 * fainter, the game seen through them; a touch still shows clearly */
+	const PictureRect picture = picture_rect(static_cast<unsigned>(room.x), static_cast<unsigned>(room.y));
+	const float columns = 0.42f * std::min(room.x, room.y);
+	const float clear = room.x > room.y ? std::clamp(static_cast<float>(picture.x) / columns, 0.0f, 1.0f) : 1.0f;
+	const auto faded = [clear](int alpha, int least) {
+		return static_cast<ImU32>(least + static_cast<int>(static_cast<float>(alpha - least) * clear));
+	};
+	const ImU32 fill = IM_COL32(255, 255, 255, faded(40, 18)), pressed = IM_COL32(255, 255, 255, 110);
+	const ImU32 line = IM_COL32(255, 255, 255, faded(120, 70)), text = IM_COL32(255, 255, 255, faded(190, 130));
+	const float thick = std::max(1.5f, std::min(room.x, room.y) * 0.004f);
+	ImFont *const font = ImGui::GetFont();
+
+	/* The speed, top left: 60 is full speed */
+	if (const float fps = g_fps.load(); fps > 0.0f) {
+		char speed[32];
+		const float size = std::max(14.0f, std::min(room.x, room.y) * 0.035f);
+
+		std::snprintf(speed, sizeof(speed), "%.0f FPS", static_cast<double>(fps));
+		draw->AddText(font, size, { size * 0.6f, size * 0.4f },
+		              fps >= 58.0f ? IM_COL32(140, 230, 140, 200) : IM_COL32(240, 170, 90, 220), speed);
+	}
+
+	for (int p = 0; p < PARTS; p++) {
+		const Shape &s = shapes[static_cast<size_t>(p)];
+		const ImU32 inside = held[static_cast<size_t>(p)] ? pressed : fill;
+
+		if (p == STICK) {
+			draw->AddCircleFilled(stick_at, s.w, IM_COL32(255, 255, 255, faded(25, 10)), 48);
+			draw->AddCircle(stick_at, s.w, line, 48, thick);
+			draw->AddCircleFilled(knob, s.w * 0.45f, inside, 32);
+			draw->AddCircle(knob, s.w * 0.45f, line, 32, thick);
+			continue;
+		}
+		float size;
+		if (s.round()) {
+			draw->AddCircleFilled({ s.x, s.y }, s.w, inside, 32);
+			draw->AddCircle({ s.x, s.y }, s.w, line, 32, thick);
+			size = s.w * 0.9f;
+		} else {
+			const ImVec2 a{ s.x - s.w * 0.5f, s.y - s.h * 0.5f }, b{ s.x + s.w * 0.5f, s.y + s.h * 0.5f };
+
+			draw->AddRectFilled(a, b, inside, s.h * 0.35f);
+			draw->AddRect(a, b, line, s.h * 0.35f, 0, thick);
+			size = s.h * 0.55f;
+		}
+		if (p == TOOLS) {
+			/* Three dots: more */
+			const float dot = s.h * 0.075f;
+
+			for (int d = -1; d <= 1; d++)
+				draw->AddCircleFilled({ s.x + static_cast<float>(d) * dot * 4.0f, s.y }, dot, text, 12);
+			continue;
+		}
+		const ImVec2 extent = font->CalcTextSizeA(size, 1e9f, 0.0f, LABELS[p]);
+
+		draw->AddText(font, size, { s.x - extent.x * 0.5f, s.y - extent.y * 0.5f }, text, LABELS[p]);
+	}
+	if (!panel)
+		return;
+
+	/* The panel of shortcuts, over a veil on the game */
+	const float u = std::min(room.x, room.y);
+	const ImVec2 a{ panel_box.x - panel_box.w * 0.5f, panel_box.y - panel_box.h * 0.5f };
+	const ImVec2 b{ panel_box.x + panel_box.w * 0.5f, panel_box.y + panel_box.h * 0.5f };
+	const float title = 0.045f * u, label = 0.05f * u, hint = 0.032f * u;
+	const ImU32 accent = IM_COL32(110, 200, 210, 230), faint = IM_COL32(255, 255, 255, 120);
+	const ImU32 warning = IM_COL32(230, 110, 95, 230);
+
+	draw->AddRectFilled({ 0, 0 }, room, IM_COL32(0, 0, 0, 110));
+	draw->AddRectFilled(a, b, IM_COL32(24, 26, 30, 235), 0.04f * u);
+	draw->AddRect(a, b, line, 0.04f * u, 0, thick);
+	draw->AddText(font, title, { a.x + 0.05f * u, a.y + 0.04f * u }, accent, "SHORTCUTS");
+	for (int k = 0; k < SHORTCUT_COUNT; k++) {
+		const Shape &s = panel_keys[static_cast<size_t>(k)];
+		const ImVec2 ka{ s.x - s.w * 0.5f, s.y - s.h * 0.5f }, kb{ s.x + s.w * 0.5f, s.y + s.h * 0.5f };
+		const Shortcut &shortcut = SHORTCUTS[k];
+		const bool waits = armed == k;
+		/* The keys of the cabinet in the accent, those that leave the
+		 * game in red, red filled when they wait for the second touch */
+		const ImU32 border = shortcut.stays ? accent : shortcut.confirm ? warning : line;
+		const char *const name = waits ? "SURE?" : shortcut.label;
+		const char *const under = waits ? "touch again" : shortcut.hint;
+
+		draw->AddRectFilled(ka, kb, waits ? IM_COL32(200, 70, 60, 120) :
+		                            panel_held[static_cast<size_t>(k)] ? pressed : fill, s.h * 0.25f);
+		draw->AddRect(ka, kb, border, s.h * 0.25f, 0, thick);
+
+		/* The words as large as the key holds them */
+		ImVec2 big = font->CalcTextSizeA(label, 1e9f, 0.0f, name);
+		ImVec2 small = font->CalcTextSizeA(hint, 1e9f, 0.0f, under);
+		const float fit_big = big.x > s.w * 0.86f ? s.w * 0.86f / big.x : 1.0f;
+		const float fit_small = small.x > s.w * 0.9f ? s.w * 0.9f / small.x : 1.0f;
+		const float size_big = label * fit_big, size_small = hint * fit_small;
+
+		big = { big.x * fit_big, big.y * fit_big };
+		small = { small.x * fit_small, small.y * fit_small };
+		const float top = s.y - (big.y + small.y * 1.1f) * 0.5f;
+
+		draw->AddText(font, size_big, { s.x - big.x * 0.5f, top }, text, name);
+		draw->AddText(font, size_small, { s.x - small.x * 0.5f, top + big.y * 1.1f }, faint, under);
+	}
+}
+
