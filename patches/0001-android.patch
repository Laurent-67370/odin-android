+
+/* iOS: the archives to add to the games chosen in the picker of documents
+ * (the Files app's places, iCloud too), several at once; iOS copies each to
+ * the app's temporary folder, whose file:// addresses are answered, one a
+ * line, as Android's picker answers. SDL has no picker on iOS. */
+
+#include "odin/host/ui/folder_dialog_ios.hpp"
+#include "odin/host/app/rom_files.hpp"
+
+#import <UIKit/UIKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+#include <SDL3/SDL_properties.h>
+#include <SDL3/SDL_video.h>
+
+#include <SDL3/SDL_error.h>
+
+#include <cstdio>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <system_error>
+#include <vector>
+
+@interface OdinPicker : NSObject <UIDocumentPickerDelegate>
+@property(nonatomic, assign) odin::PickedArchives done;
+@property(nonatomic, assign) void *userdata;
+@end
+
+namespace {
+/* The picker being shown, kept until it answers (the view controller holds
+ * its delegate weakly) */
+OdinPicker *g_picker = nil;
+
+void
+answer(OdinPicker *picker, NSArray<NSURL *> *urls)
+{
+	std::vector<std::string> lines;
+	std::vector<const char *> files;
+
+	for (NSURL *url in urls)
+		lines.push_back(url.absoluteString.UTF8String);
+	for (const std::string &line : lines)
+		files.push_back(line.c_str());
+	files.push_back(nullptr);
+	picker.done(picker.userdata, files.data(), 0);
+	g_picker = nil;
+}
+} /* namespace */
+
+@implementation OdinPicker
+- (void)documentPicker:(UIDocumentPickerViewController *)controller didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+	(void)controller;
+	answer(self, urls);
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+	(void)controller;
+	answer(self, @[]);
+}
+@end
+
+namespace {
+
+/* The view a dialog is shown from: the window's, or what it shows */
+UIViewController *
+top_of(SDL_Window *window)
+{
+	UIWindow *const shown = (__bridge UIWindow *)SDL_GetPointerProperty(
+		SDL_GetWindowProperties(window), SDL_PROP_WINDOW_UIKIT_WINDOW_POINTER, nullptr);
+	UIViewController *top = shown.rootViewController;
+
+	while (top.presentedViewController)
+		top = top.presentedViewController;
+	return top;
+}
+
+/* The answer of the homebrew games, on the main thread: the files
+ * downloaded, or the error when none was */
+void
+homebrew_done(odin::PickedArchives done, void *userdata, const std::vector<std::string> &files,
+              const std::string &error)
+{
+	std::vector<const char *> list;
+
+	for (const std::string &file : files)
+		list.push_back(file.c_str());
+	list.push_back(nullptr);
+	if (files.empty() && !error.empty()) {
+		SDL_SetError("%s", error.c_str());
+		done(userdata, nullptr, 0);
+	} else {
+		done(userdata, list.data(), 0);
+	}
+}
+
+/* The games chosen downloaded one after the other to the temporary folder,
+ * each as <name>.zip (GitHub's downloads go on elsewhere: the session
+ * follows) */
+void
+download(NSArray<NSDictionary *> *games, odin::PickedArchives done, void *userdata)
+{
+	if (games.count == 0) {
+		homebrew_done(done, userdata, {}, "");
+		return;
+	}
+	NSString *const folder = [NSTemporaryDirectory() stringByAppendingPathComponent:@"homebrew"];
+	auto files = std::make_shared<std::vector<std::string>>();
+	auto error = std::make_shared<std::string>();
+	auto left = std::make_shared<NSUInteger>(games.count);
+
+	[[NSFileManager defaultManager] createDirectoryAtPath:folder withIntermediateDirectories:YES attributes:nil error:nil];
+	for (NSDictionary *game in games) {
+		NSString *const name = [NSString stringWithFormat:@"%@", game[@"name"]];
+		NSString *const title = [NSString stringWithFormat:@"%@", game[@"title"]];
+		NSURL *const url = [NSURL URLWithString:[NSString stringWithFormat:@"%@", game[@"url"]]];
+		NSString *const path = [folder stringByAppendingPathComponent:[name stringByAppendingString:@".zip"]];
+
+		if (!url) {
+			*error = std::string("No address for ") + title.UTF8String;
+			if (--*left == 0)
+				homebrew_done(done, userdata, *files, *error);
+			continue;
+		}
+		NSURLSessionDownloadTask *const task = [[NSURLSession sharedSession]
+			downloadTaskWithURL:url
+			  completionHandler:^(NSURL *location, NSURLResponse *response, NSError *failed) {
+				  /* The file is gone once this returns: moved first */
+				  const NSInteger status = [response isKindOfClass:[NSHTTPURLResponse class]]
+				                                   ? ((NSHTTPURLResponse *)response).statusCode
+				                                   : 0;
+				  std::string why;
+
+				  if (location && !failed && status == 200) {
+					  [[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+					  NSError *moved = nil;
+					  if ([[NSFileManager defaultManager] moveItemAtURL:location
+					                                              toURL:[NSURL fileURLWithPath:path]
+					                                              error:&moved])
+						  why.clear();
+					  else
+						  why = moved.localizedDescription.UTF8String;
+				  } else {
+					  why = failed ? failed.localizedDescription.UTF8String : "HTTP " + std::to_string(status);
+				  }
+				  const std::string got = why.empty() ? std::string([NSURL fileURLWithPath:path].absoluteString.UTF8String)
+				                                      : std::string();
+				  const std::string said = why.empty() ? std::string()
+				                                       : std::string("Cannot download ") + title.UTF8String + ": " + why;
+				  dispatch_async(dispatch_get_main_queue(), ^{
+					  if (!got.empty())
+						  files->push_back(got);
+					  if (!said.empty())
+						  *error = said;
+					  if (--*left == 0)
+						  homebrew_done(done, userdata, *files, *error);
+				  });
+			  }];
+		[task resume];
+	}
+}
+
+/* A homebrew game in `roms`: "new" when it is not there, "installed" when
+ * its first EPROM (<name>.ic29) has the CRC the list gives, else "update",
+ * as on Android */
+NSString *
+status_of(const std::string &roms, NSString *name, NSString *crc)
+{
+	const std::unique_ptr<odin::Archive> archive =
+		odin::Archive::open(roms + "/" + name.UTF8String + ".zip");
+
+	if (!archive)
+		return @"new";
+
+	const std::string first = std::string(name.UTF8String) + ".ic29";
+
+	for (const odin::Archive::Entry &entry : archive->entries()) {
+		if (entry.name != first || !entry.crc_known)
+			continue;
+		char now[9];
+		std::snprintf(now, sizeof(now), "%08x", entry.crc);
+		return [crc caseInsensitiveCompare:[NSString stringWithUTF8String:now]] == NSOrderedSame ? @"installed"
+		                                                                                         : @"update";
+	}
+	return @"update";
+}
+
+/* The list shown: every game new, installed or with an update, one button
+ * each, and one for all those new or updated */
+void
+choose(SDL_Window *window, const std::string &roms, NSArray<NSDictionary *> *games, odin::PickedArchives done,
+       void *userdata)
+{
+	UIViewController *const top = top_of(window);
+
+	if (!top) {
+		homebrew_done(done, userdata, {}, "no view to show the homebrew games from");
+		return;
+	}
+	NSMutableArray<NSDictionary *> *const fresh = [NSMutableArray array];
+	UIAlertController *const alert =
+		[UIAlertController alertControllerWithTitle:@"Homebrew games"
+		                                    message:@"Free games made for Odin, downloaded from GitHub. They need the BIOS (hikaru.zip)."
+		                             preferredStyle:UIAlertControllerStyleAlert];
+
+	for (NSDictionary *game in games) {
+		NSString *const name = [NSString stringWithFormat:@"%@", game[@"name"]];
+		NSString *const status = status_of(roms, name, [NSString stringWithFormat:@"%@", game[@"crc"]]);
+		NSString *const label =
+			[NSString stringWithFormat:@"%@ - %@ (%@)", game[@"title"], game[@"genre"], status];
+
+		if (![status isEqualToString:@"installed"])
+			[fresh addObject:game];
+		[alert addAction:[UIAlertAction actionWithTitle:label
+		                                          style:UIAlertActionStyleDefault
+		                                        handler:^(UIAlertAction *action) {
+			                                        (void)action;
+			                                        download(@[ game ], done, userdata);
+		                                        }]];
+	}
+	if (fresh.count > 1) {
+		NSArray<NSDictionary *> *const all = [fresh copy];
+		[alert addAction:[UIAlertAction actionWithTitle:[NSString stringWithFormat:@"All the new and updated (%lu)",
+		                                                                           (unsigned long)all.count]
+		                                          style:UIAlertActionStyleDefault
+		                                        handler:^(UIAlertAction *action) {
+			                                        (void)action;
+			                                        download(all, done, userdata);
+		                                        }]];
+	}
+	[alert addAction:[UIAlertAction actionWithTitle:@"Cancel"
+	                                          style:UIAlertActionStyleCancel
+	                                        handler:^(UIAlertAction *action) {
+			                                        (void)action;
+		                                        homebrew_done(done, userdata, {}, "");
+	                                        }]];
+	[top presentViewController:alert animated:YES completion:nil];
+}
+
+} /* namespace */
+
+namespace odin {
+
+void
+pick_homebrew(SDL_Window *window, const std::string &roms, PickedArchives done, void *userdata)
+{
+	NSURL *const list =
+		[NSURL URLWithString:@"https://github.com/Laurent-67370/odin-android/releases/download/odin-apk/homebrew.json"];
+	const std::string folder = roms;
+
+	[[[NSURLSession sharedSession]
+		dataTaskWithURL:list
+	      completionHandler:^(NSData *data, NSURLResponse *response, NSError *failed) {
+		      (void)response;
+		      id parsed = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+		      NSArray *games = [parsed isKindOfClass:[NSDictionary class]] ? parsed[@"games"] : nil;
+		      const std::string why =
+			      failed ? std::string("No list of homebrew games (no network?): ") +
+			                       failed.localizedDescription.UTF8String
+			             : std::string("No list of homebrew games");
+
+		      dispatch_async(dispatch_get_main_queue(), ^{
+			      if ([games isKindOfClass:[NSArray class]] && games.count)
+				      choose(window, folder, games, done, userdata);
+			      else
+				      homebrew_done(done, userdata, {}, why);
+		      });
+	      }] resume];
+}
+
+void
+pick_archives(SDL_Window *window, PickedArchives done, void *userdata)
+{
+	UIViewController *const top = top_of(window);
+
+	if (!top) {
+		SDL_SetError("no view to show the picker of documents from");
+		done(userdata, nullptr, 0);
+		return;
+	}
+
+	/* Any file: a .7z is no kind iOS knows */
+	UIDocumentPickerViewController *const picker =
+		[[UIDocumentPickerViewController alloc] initForOpeningContentTypes:@[ UTTypeItem ] asCopy:YES];
+	OdinPicker *const delegate = [[OdinPicker alloc] init];
+
+	delegate.done = done;
+	delegate.userdata = userdata;
+	g_picker = delegate;
+	picker.delegate = delegate;
+	picker.allowsMultipleSelection = YES;
+	[top presentViewController:picker animated:YES completion:nil];
+}
+
+} /* namespace odin */
