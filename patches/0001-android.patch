+#ifndef ODIN_TOUCH_PAD_HPP
+#define ODIN_TOUCH_PAD_HPP
+
+namespace odin {
+
+/* A gamepad on the touch screen (Android; elsewhere with ODIN_TOUCH_PAD=1):
+ * an SDL virtual gamepad that the fingers press, drawn over the game.
+ * Controls sees it as any other pad.
+ *
+ * touch_pad_attach: the pad plugged, once the gamepads are on (Controls);
+ * touch_pad_detach: unplugged, before they go off.
+ * touch_pad_draw: its drawing added to the frame of Dear ImGui being built
+ * over the game; the fingers work it only while it is drawn, and the touches
+ * on it do not reach the game as the mouse.
+ * touch_pad_wanted: whether this host has one. */
+bool touch_pad_wanted();
+void touch_pad_attach();
+void touch_pad_detach();
+void touch_pad_draw();
+/* A game steered by two levers, one an engine (stick_y and stick2_y, no
+ * stick_x: Star Wars Racer Arcade): the one stick of the pad works both,
+ * forward together, left and right one against the other */
+void touch_pad_twin_levers(bool on);
+/* A game where player 1 aims (gun_x and gun_y: Brave Firefighters): no
+ * stick; a finger on the picture, away from the pad, aims where it is and
+ * holds the first button as the mouse does, its left button. Controls takes
+ * the mouse from touch_pad_aim then, not the one SDL makes of a touch
+ * (touch_pad_aims). */
+void touch_pad_aim_mode(bool on);
+bool touch_pad_aims();
+struct TouchAim {
+	float x, y;	/* where the finger is or was last, in points */
+	float w, h;	/* the window, in points */
+	bool down;	/* a finger on it */
+	unsigned taps;	/* the fingers come down since last asked */
+};
+/* false while no finger aimed yet */
+bool touch_pad_aim(TouchAim &aim);
+/* A game with a second stick (stick2_x: the kick of Gaelco Football): a
+ * second floating stick, over the right half of the window, beside the face
+ * buttons */
+void touch_pad_second_stick(bool on);
+/* Sticks that only work switches (a game whose directions are up, down,
+ * left, right, not an analog control): the first, the second. Such a stick
+ * gives its whole way from a third of its ring, the switches pressed from a
+ * short slide of the thumb instead of half the ring. */
+void touch_pad_quick_sticks(bool first, bool second);
+/* The frames per second, shown in a corner of the pad (0: none yet) */
+void touch_pad_speed(float fps);
+
+} /* namespace odin */
+
+#endif /* ODIN_TOUCH_PAD_HPP */
