+bool imports_games(const std::string &answer);
+
+/* Each archive of the answer copied to `roms` as <set>.zip (or .7z), the
+ * set told by the CRCs of its files, else by the name it had when that is
+ * a set's. An archive of a homebrew game may hold its description
+ * (odin-game.json, as an entry of the list): the game is added to the
+ * list, and to homebrew_list(), in the place of an older one of its name; the one there before replaced. Then each is checked as a game is
+ * before it starts (the files of the BIOS in `bios` too): `note` says, for
+ * each, whether its game is ready or what it lacks (another archive, files
+ * of another version), for a BIOS the games it makes ready, and what is no
+ * game Odin knows. The number of archives added. */
+unsigned import_games(const std::string &answer, const std::string &roms, const std::string &bios, GameList &games,
+                      std::string &note);
+
+/* The list of the homebrew games imported (odin-games-homebrew.json in
+ * the folder of the user's data), which Odin adds to its own at launch */
+std::string homebrew_list();
+
+} /* namespace odin */
