+namespace odin {
+
+namespace {
+
+/* The lines of the answer */
+std::vector<std::string>
+lines_of(const std::string &text)
+{
+	std::vector<std::string> out;
+	size_t at = 0;
+
+	while (at < text.size()) {
+		const size_t end = std::min(text.find('\n', at), text.size());
+
+		if (end > at)
+			out.push_back(text.substr(at, end - at));
+		at = end + 1;
+	}
+	return out;
+}
+
+/* %41 to A */
+std::string
+decoded(const std::string &text)
+{
+	std::string out;
+
+	for (size_t i = 0; i < text.size(); i++) {
+		const auto hex = [](char c) {
+			return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+		};
+		if (text[i] == '%' && i + 2 < text.size() && hex(text[i + 1]) >= 0 && hex(text[i + 2]) >= 0) {
+			out += static_cast<char>(hex(text[i + 1]) * 16 + hex(text[i + 2]));
+			i += 2;
+		} else {
+			out += text[i];
+		}
+	}
+	return out;
+}
+
+/* The name the archive had, as the address may tell it (".../Download/
+ * braveff (1).zip"): lower case, without its extension nor a " (1)" a
+ * download added; empty when the address tells none */
+std::string
+name_in(const std::string &address)
+{
+	std::string name = decoded(address);
+
+	name = name.substr(name.find_last_of("/:") + 1);
+	if (const size_t dot = name.rfind('.'); dot != std::string::npos)
+		name.resize(dot);
+	if (const size_t copy = name.find(" ("); copy != std::string::npos)
+		name.resize(copy);
+	std::transform(name.begin(), name.end(), name.begin(),
+	               [](unsigned char c) { return static_cast<char>(c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c); });
+	return name;
+}
+
+/* The archive at the address (content://, or file:// for one downloaded)
+ * copied to `path` whole */
+bool
+copy_to(const std::string &address, const std::string &path)
+{
+	/* file://: a path, its spaces and the like written %20 (iOS) */
+	const std::string from = address.rfind("file://", 0) == 0 ? decoded(address.substr(7)) : address;
+	SDL_IOStream *const in = SDL_IOFromFile(from.c_str(), "rb");
+
+	if (!in)
+		return false;
+
+	std::FILE *const out = std::fopen(path.c_str(), "wb");
+	bool ok = out != nullptr;
+	std::vector<char> buffer(1 << 20);
+
+	while (ok) {
+		const size_t got = SDL_ReadIO(in, buffer.data(), buffer.size());
+
+		if (got == 0) {
+			ok = SDL_GetIOStatus(in) == SDL_IO_STATUS_EOF;
+			break;
+		}
+		ok = std::fwrite(buffer.data(), 1, got, out) == got;
+	}
+	if (out)
+		ok = std::fclose(out) == 0 && ok;
+	SDL_CloseIO(in);
+	return ok;
+}
+
+/* "a, b, c" of the names, the first `most` and how many more */
+std::string
+listed(const std::vector<std::string> &names, size_t most = 4)
+{
+	std::string out;
+
+	for (size_t i = 0; i < names.size() && i < most; i++)
+		out += (out.empty() ? "" : ", ") + (names[i].empty() ? std::string("?") : names[i]);
+	if (names.size() > most)
+		out += " and " + std::to_string(names.size() - most) + " more";
+	return out;
+}
+
+/* What an archive added makes of its game, as the game is checked before
+ * it starts: ready, the archives it still lacks, or the files of its own
+ * that are not the list's (another version, or missing); for a set no game
+ * is named after (a BIOS), the games it makes ready */
+std::string
+status_of(const std::string &set, const std::string &roms, const std::string &bios, const GameList &games)
+{
+	RomFiles files(roms, bios);
+	std::string title;
+
+	for (const auto &[game, name] : games.titles())
+		if (game == set)
+			title = name;
+	if (title.empty()) {
+		std::vector<std::string> ready;
+
+		for (const GameList::Entry &entry : games.entries()) {
+			bool uses = false;
+
+			for (const RomFiles::File &file : games.files_of(entry.name))
+				uses = uses || file.set_of(entry.name) == set;
+			if (uses && games.missing(files, entry.name).empty())
+				ready.push_back(entry.title);
+		}
+		return ready.empty() ? "a BIOS, no game ready with it yet" : "a BIOS, games ready: " + listed(ready);
+	}
+
+	std::vector<std::string> lacking, other;
+
+	for (const RomFiles::File &file : games.missing(files, set)) {
+		const std::string archive = file.set_of(set) + ".zip";
+
+		if (!files.set_there(set, file)) {
+			if (std::find(lacking.begin(), lacking.end(), archive) == lacking.end())
+				lacking.push_back(archive);
+		} else {
+			other.push_back(file.name);
+		}
+	}
+	if (lacking.empty() && other.empty())
+		return title + " ready to play";
+	std::string out = title;
+
+	if (!lacking.empty())
+		out += ", needs " + listed(lacking);
+	if (!other.empty())
+		out += (lacking.empty() ? ", " : "; ") + std::string("files missing or of another version: ") + listed(other);
+	return out;
+}
+
+/* The description an archive of a homebrew game holds, added to the list
+ * and kept in homebrew_list(); the game's name, empty when there is none
+ * or it is refused (`refused` then says why) */
+std::string
+homebrew_in(Archive &archive, GameList &games, std::string &refused)
+{
+	const std::vector<Archive::Entry> &entries = archive.entries();
+
+	for (size_t i = 0; i < entries.size(); i++) {
+		if (entries[i].name != "odin-game.json")
+			continue;
+
+		const std::optional<std::vector<uint8_t>> text = archive.read(i);
+		json_error_t error;
+		json_t *const entry = text ? json_loadb(reinterpret_cast<const char *>(text->data()), text->size(), 0, &error)
+		                           : nullptr;
+		std::string why;
+		const std::string name = entry ? games.add_homebrew(entry, why) : std::string();
+
+		if (!entry)
+			why = "its odin-game.json cannot be read";
+		if (name.empty()) {
+			std::fprintf(stderr, "ERROR: import: %s\n", why.c_str());
+			refused = why;
+		}
+		if (entry)
+			json_decref(entry);
+		if (name.empty())
+			return {};
+
+		/* Kept for the next launch, in the place of the one of its name */
+		const std::string path = homebrew_list();
+		std::error_code made;
+
+		std::filesystem::create_directories(std::filesystem::path(path).parent_path(), made);
+		json_t *list = json_load_file(path.c_str(), 0, &error);
+
+		if (!json_is_array(json_object_get(list, "roms"))) {
+			if (list)
+				json_decref(list);
+			list = json_pack("{s:i, s:[]}", "version", 2, "roms");
+		}
+		json_t *const roms = json_object_get(list, "roms");
+		json_t *const now = json_deep_copy(games.entry_of(name));
+		size_t at = json_array_size(roms);
+
+		for (size_t r = 0; r < json_array_size(roms); r++)
+			if (name == json_string_value(json_object_get(json_array_get(roms, r), "name")))
+				at = r;
+		if (at < json_array_size(roms))
+			json_array_set_new(roms, at, now);
+		else
+			json_array_append_new(roms, now);
+		if (json_dump_file(list, path.c_str(), JSON_INDENT(1)) != 0)
+			std::fprintf(stderr, "ERROR: import: cannot write '%s'\n", path.c_str());
+		json_decref(list);
+		std::printf("import: homebrew game '%s' added to the list ('%s')\n", name.c_str(), path.c_str());
+		return name;
+	}
+	return {};
+}
+
+} /* namespace */
+
+std::string
+homebrew_list()
+{
+	return user_data_dir() + "/odin-games-homebrew.json";
+}
+
+bool
+imports_games(const std::string &answer)
+{
+	return answer.rfind("content://", 0) == 0 || answer.rfind("file://", 0) == 0;
+}
+
+unsigned
+import_games(const std::string &answer, const std::string &roms, const std::string &bios, GameList &games,
+             std::string &note)
+{
+	std::error_code error;
+	std::vector<std::string> added, kinds, refused;
+
+	std::filesystem::create_directories(roms, error);
+	for (const std::string &address : lines_of(answer)) {
+		const std::filesystem::path held = std::filesystem::path(roms) / ".import.tmp";
+
+		if (!copy_to(address, held.string())) {
+			std::fprintf(stderr, "ERROR: import: cannot read '%s': %s\n", address.c_str(), SDL_GetError());
+			refused.push_back(name_in(address));
+			std::filesystem::remove(held, error);
+			continue;
+		}
+
+		/* The homebrew game it describes, else the set its files are, else
+		 * the name it had */
+		std::string set, kind = ".zip", why;
+		{
+			const std::unique_ptr<Archive> archive = Archive::open(held.string());
+
+			if (archive) {
+				std::vector<uint32_t> crcs;
+
+				set = homebrew_in(*archive, games, why);
+				for (const Archive::Entry &entry : archive->entries())
+					if (entry.crc_known)
+						crcs.push_back(entry.crc);
+				if (set.empty() && why.empty())
+					set = games.set_holding(crcs);
+				if (set.empty() && why.empty()) {
+					const std::string named = name_in(address);
+
+					for (const auto &[game, title] : games.titles())
+						if (game == named)
+							set = named;
+				}
+				if (std::FILE *const file = std::fopen(held.string().c_str(), "rb")) {
+					if (std::fgetc(file) == '7')
+						kind = ".7z";
+					std::fclose(file);
+				}
+			} else {
+				std::fprintf(stderr, "ERROR: import: '%s' is no zip nor 7z\n", address.c_str());
+			}
+		}
+		if (set.empty()) {
+			if (why.empty())
+				std::fprintf(stderr, "ERROR: import: '%s' holds no game Odin knows\n", address.c_str());
+			refused.push_back(name_in(address) + (why.empty() ? "" : " (" + why + ")"));
+			std::filesystem::remove(held, error);
+			continue;
+		}
+
+		/* In the place of the set's archive, of either kind */
+		const std::filesystem::path to = std::filesystem::path(roms) / (set + kind);
+		const std::filesystem::path other = std::filesystem::path(roms) / (set + (kind == ".zip" ? ".7z" : ".zip"));
+
+		std::filesystem::remove(other, error);
+		std::filesystem::rename(held, to, error);
+		if (error) {
+			std::fprintf(stderr, "ERROR: import: cannot write '%s': %s\n", to.string().c_str(), error.message().c_str());
+			refused.push_back(set);
+			std::filesystem::remove(held, error);
+			continue;
+		}
+		std::printf("import: '%s' as '%s'\n", address.c_str(), to.string().c_str());
+		/* A download, in the activity's cache: done with */
+		if (address.rfind("file://", 0) == 0)
+			std::filesystem::remove(address.substr(7), error);
+		added.push_back(set);
+		kinds.push_back(kind);
+	}
+
+	/* Checked once all are there: a game and its BIOS chosen together */
+	note.clear();
+	for (size_t i = 0; i < added.size(); i++) {
+		const std::string status = status_of(added[i], roms, bios, games);
+
+		std::printf("import: %s%s: %s\n", added[i].c_str(), kinds[i].c_str(), status.c_str());
+		note += (note.empty() ? "" : ". ") + added[i] + kinds[i] + ": " + status;
+	}
+	if (!refused.empty())
+		note += (note.empty() ? "" : ". ") + std::string("Not added: ") + listed(refused);
+	return static_cast<unsigned>(added.size());
+}
+
+} /* namespace odin */
