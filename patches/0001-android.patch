+std::string
+GameList::add_homebrew(json_t *entry, std::string &why)
+{
+	json_t *const roms = json_object_get(m_root, "roms");
+	const char *const name = json_string_value(json_object_get(entry, "name"));
+	const char *const mach = json_string_value(json_object_get(entry, "mach"));
+
+	why.clear();
+	if (!json_is_array(roms))
+		why = "no game list";
+	else if (!json_is_object(entry) || !name || !mach)
+		why = "not a game of the list";
+	else if (!json_is_true(json_object_get(entry, "homebrew")))
+		why = "not a homebrew game";
+	else if (std::strcmp(mach, "hikaru") || json_object_get(entry, "parent"))
+		why = "only Hikaru games, no versions";
+	else if (!*name || std::strlen(name) > 16 ||
+	         std::any_of(name, name + std::strlen(name),
+	                     [](char c) { return !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_'); }))
+		why = "a name of a to z, 0 to 9, _";
+	if (!why.empty())
+		return {};
+
+	const std::string game = name;
+	size_t at = json_array_size(roms);
+
+	for (size_t i = 0; i < json_array_size(roms); i++)
+		if (game == json_string_value(json_object_get(json_array_get(roms, i), "name")))
+			at = i;
+	json_t *const before = at < json_array_size(roms) ? json_incref(json_array_get(roms, at)) : nullptr;
+
+	if (before && !json_is_true(json_object_get(before, "homebrew"))) {
+		json_decref(before);
+		why = "'" + game + "' is a game of Odin's list, not a homebrew one";
+		return {};
+	}
+	if (before)
+		json_array_set(roms, at, entry);
+	else
+		json_array_append(roms, entry);
+	/* What Odin needs of a game, read as it is before it starts */
+	if (!describe(game) || files_of(game).empty()) {
+		if (before)
+			json_array_set(roms, at, before);
+		else
+			json_array_remove(roms, json_array_size(roms) - 1);
+		if (before)
+			json_decref(before);
+		why = "the description of '" + game + "' is not right";
+		return {};
+	}
+	if (before)
+		json_decref(before);
+	return game;
+}
+
+unsigned
+GameList::add_homebrew_list(const std::string &path, RomFiles &files)
+{
+	json_error_t error;
+	json_t *const list = json_load_file(path.c_str(), 0, &error);
+	unsigned added = 0;
+
+	if (!list)
+		return 0;
+	json_t *const roms = json_object_get(list, "roms");
+
+	for (size_t i = 0; i < json_array_size(roms); i++) {
+		const char *const name = json_string_value(json_object_get(json_array_get(roms, i), "name"));
+		std::string why;
+
+		if (name && find(name) && missing(files, name).empty())
+			continue;
+		if (!add_homebrew(json_array_get(roms, i), why).empty())
+			added++;
+		else
+			std::fprintf(stderr, "ERROR: '%s', game %zu: %s\n", path.c_str(), i + 1, why.c_str());
+	}
+	json_decref(list);
+	if (added)
+		std::printf("loading %u homebrew games from '%s'\n", added, path.c_str());
+	return added;
+}
+
+std::vector<RomFiles::File>
+GameList::files_of(const std::string &name) const
+{
+	const json_t *const rom = find(name);
+	const json_t *const sections = json_object_get(rom, "sections");
+	const char *const parent = json_string_value(json_object_get(rom, "parent"));
+	std::vector<RomFiles::File> out;
+
+	for (size_t i = 0; i < json_array_size(sections); i++) {
+		const json_t *const data = json_object_get(json_array_get(sections, i), "data");
+
+		for (size_t j = 0; j < json_array_size(data); j++)
+			if (const std::optional<RomFiles::File> file = file_of(json_array_get(data, j), parent ? parent : ""))
+				out.push_back(*file);
+	}
+	return out;
+}
+
+std::string
+GameList::set_holding(const std::vector<uint32_t> &crcs) const
+{
+	std::map<std::string, std::set<uint32_t>> held;
+	std::set<std::string> versions;
+
+	for (const Entry &entry : entries()) {
+		if (!entry.parent.empty())
+			versions.insert(entry.name);
+		for (const RomFiles::File &file : files_of(entry.name))
+			if (file.crc && std::find(crcs.begin(), crcs.end(), *file.crc) != crcs.end())
+				held[file.set_of(entry.name)].insert(*file.crc);
+	}
+
+	std::string best;
+	size_t most = 0;
+
+	for (const auto &[set, found] : held)
+		if (found.size() > most || (found.size() == most && versions.count(best) && !versions.count(set))) {
+			best = set;
+			most = found.size();
+		}
+	return best;
+}
+
 std::optional<Game>
 GameList::load_game(RomFiles &files, const std::string &name) const
 {
